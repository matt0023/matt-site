---
import BaseLayout from "../layouts/BaseLayout.astro";
import PoliticianCard from "../components/PoliticianCard.astro";
import ShareOnX from "../components/ShareOnX.astro";
import {
  CHAMBERS,
  CHAMBER_LABELS,
  PARTY_LABELS,
  PARTIES,
  politicians,
  politiciansInChamber,
  stateName,
  type Chamber,
  type Party,
  type StateCode,
} from "../data/politicians";

const total = politicians.length;
const senate = politiciansInChamber("senate");
const house = politiciansInChamber("house");
const states = [...new Set(politicians.map((politician) => politician.state))].sort((a, b) =>
  stateName(a).localeCompare(stateName(b), "en"),
);

const count = (party?: Party, state?: StateCode, chamber?: Chamber) =>
  politicians.filter(
    (politician) =>
      (party === undefined || politician.party === party) &&
      (state === undefined || politician.state === state) &&
      (chamber === undefined || politician.chamber === chamber),
  ).length;
---

<BaseLayout
  title="America First list"
  description="A filterable public-record list of U.S. politicians who do not support America First policies. The Senate is listed first. Criteria coming soon."
>
  <section class="hero">
    <div class="stars" aria-hidden="true"></div>
    <div class="shell">
      <p class="kicker">Public record · Senate first</p>
      <h1>America<br />First</h1>
      <p class="lede">
        A filterable list of U.S. politicians who do not support America First policies. The Senate is the open docket. The House is next. Criteria coming soon.
      </p>
    </div>
  </section>

  <div class="sheet">
    <form id="filters" action="/" method="get">
      <label>
        <span>Chamber</span>
        <select name="chamber">
          <option value="">Senate and House ({total})</option>
          {
            CHAMBERS.map((chamber) => (
              <option value={chamber}>
                {CHAMBER_LABELS[chamber]} ({count(undefined, undefined, chamber)})
              </option>
            ))
          }
        </select>
      </label>
      <label>
        <span>Party</span>
        <select name="party">
          <option value="">All parties ({total})</option>
          {
            PARTIES.map((party) => (
              <option value={party}>
                {PARTY_LABELS[party]} ({count(party)})
              </option>
            ))
          }
        </select>
      </label>
      <label>
        <span>State</span>
        <select name="state">
          <option value="">All states ({total})</option>
          {
            states.map((state) => (
              <option value={state}>
                {stateName(state)} ({count(undefined, state)})
              </option>
            ))
          }
        </select>
      </label>
      <label>
        <span>Name</span>
        <input name="q" type="search" autocomplete="off" />
      </label>
      <button type="submit">Apply filters</button>
    </form>

    <div class="toolbar">
      <p id="count" aria-live="polite">Showing {total} of {total}</p>
      <ShareOnX text="US politicians who don't support America First policies" />
    </div>
    <div id="empty" class="empty-file" hidden>
      <p class="stamp">No match</p>
      <h2>No file fits these filters.</h2>
      <p>Clear a filter, or switch the chamber.</p>
    </div>

    <section id="chamber-senate" data-chamber-section="senate">
      <div class="chamber-head">
        <h2>The Senate</h2>
        <a href="/senate">Open the Senate page</a>
      </div>
      <ul class="cards">
        {senate.map((politician) => <PoliticianCard politician={politician} />)}
      </ul>
      <div id="senate-empty" class="empty-file" data-placeholder hidden>
        <p class="stamp">No match</p>
        <h2>No Senate file fits these filters.</h2>
      </div>
    </section>

    <section id="chamber-house" data-chamber-section="house">
      <div class="chamber-head">
        <h2>The House</h2>
        <a href="/house">Open the House page</a>
      </div>
      <ul class="cards">
        {house.map((politician) => <PoliticianCard politician={politician} />)}
      </ul>
      {
        house.length === 0 ? (
          <div id="house-soon" class="coming-soon" data-placeholder>
            <p class="stamp">Coming soon</p>
            <h2>The House docket is next.</h2>
            <p>No House file is in the record yet. This section fills in when the first one is added.</p>
          </div>
        ) : (
          <div id="house-empty" class="empty-file" data-placeholder hidden>
            <p class="stamp">No match</p>
            <h2>No House file fits these filters.</h2>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<script>
  import { initFilters } from "../scripts/filters";
  initFilters();
</script>
