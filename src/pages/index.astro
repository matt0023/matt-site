---
import BaseLayout from "../layouts/BaseLayout.astro";
import PoliticianCard from "../components/PoliticianCard.astro";
import ShareOnX from "../components/ShareOnX.astro";
import {
  PARTY_LABELS,
  PARTIES,
  politicians,
  stateName,
  type Party,
  type StateCode,
} from "../data/politicians";

const total = politicians.length;
const parties = PARTIES;
const states = [...new Set(politicians.map((politician) => politician.state))].sort(
  (a, b) => stateName(a).localeCompare(stateName(b), "en"),
);

const count = (party?: Party, state?: StateCode) =>
  politicians.filter(
    (politician) =>
      (party === undefined || politician.party === party) &&
      (state === undefined || politician.state === state),
  ).length;
---

<BaseLayout
  title="America First list"
  description="A filterable public-record list of U.S. politicians who do not support America First policies. Criteria coming soon."
>
  <section class="hero">
    <div class="stars" aria-hidden="true"></div>
    <div class="shell">
      <p class="kicker">Public record · Docket</p>
      <h1>America<br />First</h1>
      <p class="lede">
        A filterable list of U.S. politicians who do not support America First policies. Criteria coming soon.
      </p>
    </div>
  </section>

  <div class="sheet">
    <form id="filters" action="/" method="get">
      <label>
        <span>Party</span>
        <select name="party">
          <option value="">All parties ({total})</option>
          {
            parties.map((party) => (
              <option value={party}>
                {PARTY_LABELS[party]} ({count(party)})
              </option>
            ))
          }
        </select>
      </label>
      <label>
        <span>State</span>
        <select name="state">
          <option value="">All states ({total})</option>
          {
            states.map((state) => (
              <option value={state}>
                {stateName(state)} ({count(undefined, state)})
              </option>
            ))
          }
        </select>
      </label>
      <label>
        <span>Name</span>
        <input name="q" type="search" autocomplete="off" />
      </label>
      <button type="submit">Apply filters</button>
    </form>

    <div class="toolbar">
      <p id="count" aria-live="polite">Showing {total} of {total}</p>
      <ShareOnX text="US politicians who don't support America First policies" />
    </div>
    <div id="empty" class="empty-file" hidden>
      <p class="stamp">No match</p>
      <h2>No file fits these filters.</h2>
      <p>Clear the name, or choose another party or state.</p>
    </div>

    <ul class="cards">
      {politicians.map((politician) => <PoliticianCard politician={politician} />)}
    </ul>
  </div>
</BaseLayout>

<script>
  import { initFilters } from "../scripts/filters";
  initFilters();
</script>
