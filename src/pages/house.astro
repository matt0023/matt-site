---
import BaseLayout from "../layouts/BaseLayout.astro";
import PoliticianCard from "../components/PoliticianCard.astro";
import { politiciansInChamber } from "../data/politicians";

const people = politiciansInChamber("house");
---

<BaseLayout
  title="The House · America First list"
  description="House case files on the America First list. None are filed yet."
>
  <section class="page-intro" data-reveal>
    <p class="kicker">Chamber · House</p>
    <h1>The House</h1>
    {
      people.length === 0 ? (
        <div class="coming-soon">
          <p class="stamp">Coming soon</p>
          <h2>The House docket is next.</h2>
          <p>No House file is in the record yet. Add one with chamber set to house.</p>
        </div>
      ) : (
        <>
          <p class="lede">
            {people.length} {people.length === 1 ? "House file" : "House files"}.
          </p>
          <ul class="cards">
            {people.map((politician) => (
              <PoliticianCard politician={politician} />
            ))}
          </ul>
        </>
      )
    }
    <p><a href="/">Back to the full list</a></p>
  </section>
</BaseLayout>
